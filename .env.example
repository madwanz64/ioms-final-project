# Salin file ini menjadi .env lalu sesuaikan nilainya. .env TIDAK di-commit.
#   cp .env.example .env

# Zona waktu bisnis untuk tanggal order, laporan, dan timestamp ledger.
APP_TIMEZONE=Asia/Jakarta

# --- Database -----------------------------------------------------------------
# Docker Compose: DB_HOST/DB_PORT/DB_USER diatur compose.yaml (service "db"), cukup isi DB_PASS.
# Tanpa Docker (MySQL lokal): sesuaikan semua nilai di bawah dengan MySQL Anda.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ioms
DB_USER=root
# Contoh nilai untuk development saja — BUKAN kredensial produksi. Docker memakai nilai ini
# sebagai password root MySQL di container saat volume database pertama kali dibuat.
DB_PASS=ioms_dev_password

# Database terpisah untuk integration test (dibuat ulang dari schema-and-seed.sql).
DB_TEST_NAME=ioms_test

# --- Upload ---------------------------------------------------------------------
# Batas ukuran upload gambar produk (byte). 2097152 = 2 MB.
UPLOAD_MAX_BYTES=2097152

# --- Port di host (opsional, khusus Docker) -------------------------------------
APP_PORT=8080
DB_HOST_PORT=3307

# --- SonarQube (opsional, profile "sonar") ---------------------------------------
# Token dibuat di http://localhost:9000 (My Account > Security). Jangan di-commit.
SONAR_PORT=9000
SONAR_TOKEN=
